{
  "appId": "com.sebpapple.gridgames",
  "appName": "Grid Games",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#f4f7f4",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT",
      "hidden": false,
      "animation": "NONE"
    }
  }
}
